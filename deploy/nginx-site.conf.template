# Paste as the complete configuration of the new, plain static site in BaoTa.
server {
    listen 80;
    server_name __SERVER_NAME__;
    root /opt/campus-radar/current/frontend;
    index index.html;
    client_max_body_size 101m;
    access_log /www/wwwlogs/campus-radar.access.log;
    error_log /www/wwwlogs/campus-radar.error.log warn;

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location = /index.html {
        add_header Cache-Control "no-store" always;
    }
    location ^~ /.well-known/acme-challenge/ {
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
    location ~ /\. {
        deny all;
    }
}
