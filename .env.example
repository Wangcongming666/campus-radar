# Web: mock is the default preview mode. No real credentials in this file.
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
APP_ORIGIN=http://127.0.0.1:3000
# Local compose credentials only; replace in any shared environment.
DATABASE_URL=postgresql://campus_web_login:localwebpassword@localhost:54322/campus_radar
DATABASE_DIRECT_URL=postgresql://postgres:localownerpassword@localhost:54322/campus_radar
DATABASE_WORKER_URL=postgresql://campus_worker_login:localworkerpassword@localhost:54322/campus_radar
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Current BFF server uses SUPABASE_ANON_KEY (public project key, server-side here).
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_COOKIE_SECRET=
# Base64 encoded 32-byte key. Generate locally; never prefix with NEXT_PUBLIC_.
SESSION_ENCRYPTION_KEY=
STORAGE_BUCKET_PRIVATE=
# Leave disabled until export and identity/storage erasure are fully integrated.
TASK_PROCESSING_ENABLED=false
WORKER_DATABASE_URL=postgresql://campus_worker_login:localworkerpassword@localhost:54322/campus_radar
SCHEDULER_DATABASE_URL=postgresql://campus_scheduler_login:localschedulerpassword@localhost:54322/campus_radar
WORKER_CONTROL_TOKEN=
WORKER_HMAC_KEY=
WORKER_HMAC_KEY_ID=
WEB_INTERNAL_ORIGIN=http://localhost:3000
# Empty allowlist keeps crawling OFF even for database-approved sources.
CRAWL_ALLOWED_SOURCES=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
TRANSCRIPTION_API_KEY=
AI_PRICE_TABLE=
AI_DAILY_BUDGET_CNY=50
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
# Optional: disposable migrated PG owner used only by worker integration tests.
TEST_DATABASE_URL=
